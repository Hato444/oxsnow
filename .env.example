# Gmail SMTP — used by /api/contact to deliver contact-form messages
# to oxsnowstudio@gmail.com.
#
# GMAIL_USER         = the full Gmail address
# GMAIL_APP_PASSWORD = the 16-character Google App Password (no spaces)
#
# Create it once at https://myaccount.google.com/apppasswords
# (2-Step Verification must be ON first).

GMAIL_USER=oxsnowstudio@gmail.com
GMAIL_APP_PASSWORD=

# ── Community backend ──────────────────────────────────────────────

# Postgres connection string (Neon or any Postgres).
# On Vercel: create a Neon store in Storage, then copy POSTGRES_URL.
POSTGRES_URL=

# Shared password founders use to log in and manage the community.
FOUNDER_PASSWORD=

# Random secret used to sign session cookies.
# Generate one: openssl rand -hex 32
AUTH_SECRET=

# Vercel Blob token — enables image/video uploads in the composer.
# On Vercel: Storage → Create Blob store, then BLOB_READ_WRITE_TOKEN
# is injected automatically.
BLOB_READ_WRITE_TOKEN=

# Secret for the daily cleanup cron. Vercel sends it as
# "Authorization: Bearer $CRON_SECRET" on scheduled invocations.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# How many days to keep unpinned community posts before auto-deleting.
# Default: 90
POST_RETENTION_DAYS=90
